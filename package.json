{
  "name": "dlaoshi-outfit",
  "version": "2.2.2",
  "type": "module",
  "description": "Anime whale-boy maid-outfit desktop pet, token/think-time standee and liquid-glass theme for DeepSeek Harness",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "files": [
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/use3346631993/dlaoshi-outfit.git"
  },
  "homepage": "https://github.com/use3346631993/dlaoshi-outfit#readme",
  "bugs": {
    "url": "https://github.com/use3346631993/dlaoshi-outfit/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "desktop-pet",
    "anime",
    "whale-boy",
    "maid",
    "wallpaper",
    "glassmorphism"
  ],
  "scripts": {
    "check": "node --check client.js && node --check index.js",
    "test": "node test/verify_pet_outfit.cjs && node test/verify_pet_poke.cjs && node test/verify_pet_states.cjs && node test/verify_turn_stats.cjs"
  }
}
